{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:youthlm:contracts:presentation-result:0.1.0",
  "title": "YouthLM PresentationResult v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "project_id",
    "presentation_id",
    "source_module_ids",
    "title",
    "status",
    "output_format",
    "media_type",
    "file_name",
    "file_size_bytes",
    "artifact_sha256",
    "download_url",
    "created_at",
    "warnings"
  ],
  "properties": {
    "contract_version": {
      "$ref": "urn:youthlm:contracts:common:0.1.0#/$defs/ContractVersion"
    },
    "project_id": {
      "$ref": "urn:youthlm:contracts:common:0.1.0#/$defs/Identifier"
    },
    "presentation_id": {
      "$ref": "urn:youthlm:contracts:common:0.1.0#/$defs/Identifier"
    },
    "source_module_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:youthlm:contracts:common:0.1.0#/$defs/Identifier"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "const": "ready"
    },
    "output_format": {
      "const": "pptx"
    },
    "media_type": {
      "const": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
    },
    "file_name": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.pptx$"
    },
    "file_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "download_url": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "urn:youthlm:contracts:common:0.1.0#/$defs/Warning"
      }
    }
  }
}
