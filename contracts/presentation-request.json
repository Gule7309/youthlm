{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:youthlm:contracts:presentation-request:0.1.0",
  "title": "YouthLM PresentationRequest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "project_id",
    "source_module_ids",
    "title",
    "output_format"
  ],
  "properties": {
    "contract_version": {
      "$ref": "urn:youthlm:contracts:common:0.1.0#/$defs/ContractVersion"
    },
    "project_id": {
      "$ref": "urn:youthlm:contracts:common:0.1.0#/$defs/Identifier"
    },
    "source_module_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:youthlm:contracts:common:0.1.0#/$defs/Identifier"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "default": "zh-TW"
    },
    "template_id": {
      "$ref": "urn:youthlm:contracts:common:0.1.0#/$defs/Identifier"
    },
    "output_format": {
      "const": "pptx"
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
