# Reference only. Export real values in your shell; never commit keys.
# The Workshop Access Code is portal-only and must never be placed in this file.

MODEL_PROVIDER=gemini
GEMINI_MODEL_ID=gemini-3.1-flash-lite
GEMINI_API_KEY=replace-locally
GEMINI_REQUEST_TIMEOUT_SECONDS=45
GEMINI_THINKING_LEVEL=low

# Local development persistence. The SQLite file is gitignored.
# The container image overrides both paths to /data; mount /data persistently.
YOUTHLM_SQLITE_PATH=var/youthlm.sqlite3
YOUTHLM_ARTIFACT_DIR=var/artifacts

# Exact comma-separated browser origins when the API is hosted separately.
# Prefer the bundled same-origin container in production. Never use a wildcard.
# YOUTHLM_CORS_ORIGINS=https://replace-with-frontend-origin.example

# Event-day Bedrock values. Use the region and model ID issued by the organizer.
# AWS_PROFILE is only for the local CLI/PowerShell preflight. Do not set it in
# an EC2/ECS container; attach an instance/task role and use boto3's default
# credential chain. Never copy profiles or long-lived keys into the image.
# AWS_PROFILE=youthlm-workshop
AWS_REGION=replace-on-event-day
BEDROCK_MODEL_ID=replace-on-event-day

# The production image sets these values itself. For local Vite development,
# leave web serving disabled and continue using the Vite dev server.
# YOUTHLM_SERVE_WEB=true
# YOUTHLM_WEB_DIST_DIR=apps/web/dist
# YOUTHLM_SQLITE_PATH=/data/youthlm.sqlite3
# YOUTHLM_ARTIFACT_DIR=/data/artifacts
